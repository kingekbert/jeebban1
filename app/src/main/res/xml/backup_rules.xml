<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude sensitive local financial database and shared preferences from system backup -->
    <exclude domain="database" path="fintrack_database.db" />
    <exclude domain="database" path="fintrack_database.db-shm" />
    <exclude domain="database" path="fintrack_database.db-wal" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
