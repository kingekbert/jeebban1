<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/widget_item_background"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Row: Bank + Account & Amount + Type -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_item_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="برداشت"
            android:textColor="@color/widget_expense_color"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_item_bank"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="بانک ملت"
            android:textColor="@color/widget_title_color"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_item_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="۵۰,۰۰۰ تومان"
            android:textColor="@color/widget_expense_color"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Middle Row: Date & Note snippet -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_item_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="امروز"
            android:textColor="@color/widget_status_color"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/tv_item_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="خرید از فروشگاه"
            android:textColor="@color/widget_subtitle_color"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- Bottom Action Row: Category Selector & Quick Register Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Category Picker Button (1-tap opens quick category dialog) -->
        <TextView
            android:id="@+id/btn_item_category"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/widget_item_btn_secondary_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="دسته: نامشخص 🏷️"
            android:textColor="@color/widget_category_badge_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Quick Register Action Button (1-tap with current suggested category) -->
        <TextView
            android:id="@+id/btn_item_register"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_item_btn_bg"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="ثبت سریع ⚡"
            android:textColor="@color/widget_btn_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
