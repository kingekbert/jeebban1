<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/widget_item_background"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Row: Bank + Account & Amount + Type -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_item_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="برداشت"
            android:textColor="@color/widget_expense_color"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_item_bank"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="بانک ملت"
            android:textColor="@color/widget_title_color"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_item_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="۵۰,۰۰۰ تومان"
            android:textColor="@color/widget_expense_color"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Middle Row: Date & Note snippet -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_item_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="امروز"
            android:textColor="@color/widget_status_color"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/tv_item_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="خرید از فروشگاه"
            android:textColor="@color/widget_subtitle_color"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- Bottom Action Row: Up to 4 Starred Category Buttons + Always "سایر..." -->
    <LinearLayout
        android:id="@+id/widget_category_button_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Starred Category 1 -->
        <TextView
            android:id="@+id/btn_fav_1"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_cat_btn_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="خوراک"
            android:textColor="@color/widget_cat_btn_text"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <!-- Starred Category 2 -->
        <TextView
            android:id="@+id/btn_fav_2"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_cat_btn_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="حمل‌ونقل"
            android:textColor="@color/widget_cat_btn_text"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <!-- Starred Category 3 -->
        <TextView
            android:id="@+id/btn_fav_3"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_cat_btn_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="خرید"
            android:textColor="@color/widget_cat_btn_text"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <!-- Starred Category 4 -->
        <TextView
            android:id="@+id/btn_fav_4"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_cat_btn_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="قبوض"
            android:textColor="@color/widget_cat_btn_text"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <!-- Always Present: "سایر..." Button -->
        <TextView
            android:id="@+id/btn_fav_more"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:layout_weight="0.9"
            android:background="@drawable/widget_cat_more_btn_bg"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="سایر..."
            android:textColor="@color/widget_cat_more_btn_text"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
